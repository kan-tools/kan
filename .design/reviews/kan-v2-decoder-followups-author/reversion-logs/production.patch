diff --git a/.design/kan-v2-session-reconstruction.md b/.design/kan-v2-session-reconstruction.md
index fc8e38d..fc29624 100644
--- a/.design/kan-v2-session-reconstruction.md
+++ b/.design/kan-v2-session-reconstruction.md
@@ -179,0 +180,17 @@ is added by this pure function.
+
+### Decoder review decisions
+
+The first independent decoder review found that Serde's internally tagged unit
+variant silently ignores extra fields. Forwarding-intent now explicitly refuses
+anything beyond its type field; every recognized event has an extra-field test.
+A recognized header must include `observed_at_unix_micros`: explicit null retains
+the recorder's unavailable-clock claim, whereas absence is malformed. Unknown
+variants still accept no semantic interpretation. Noncanonical JSON whitespace
+and escaping remain accepted when unambiguous; exact original spans are retained.
+
+For every input beginning `KANC`, the total-frame size limit precedes envelope
+version classification, including unknown envelope versions. Thus oversized
+unknown KANC-family data is a limit refusal. Inputs without the KANC prefix remain
+opaque without parsing or copying, regardless of size. Downstream source-read
+budgets remain responsible for all input acquisition. These choices do not
+assert coverage or close the parent reconstruction acceptance criteria.
diff --git a/src/evidence_reconstruction.rs b/src/evidence_reconstruction.rs
index 58f1fce..2cd45d3 100644
--- a/src/evidence_reconstruction.rs
+++ b/src/evidence_reconstruction.rs
@@ -132,0 +133,10 @@ pub fn decode(bytes: &[u8]) -> Result<Decoded<'_>, Error> {
+    // An absent clock claim is not the explicit null emitted by the recorder.
+    if !object.contains_key("observed_at_unix_micros") {
+        return Err(Error::Header);
+    }
+    // Serde's internally tagged unit variant accepts extra map entries even
+    // with deny_unknown_fields. Do not silently discard fields from a recognized
+    // forwarding intent; the struct variants retain their derived strict checks.
+    if kind == "forwarding-intent" && event.len() != 1 {
+        return Err(Error::Header);
+    }
diff --git a/tests/evidence_reconstruction.rs b/tests/evidence_reconstruction.rs
index 0e71c5b..4f95704 100644
--- a/tests/evidence_reconstruction.rs
+++ b/tests/evidence_reconstruction.rs
@@ -321,0 +322,67 @@ fn multibyte_and_escaped_header_text_preserves_original_byte_spans() {
+
+#[test]
+fn every_recognized_event_rejects_extra_fields_including_unit_variants() {
+    for event in [
+        serde_json::json!({"type":"started","method":"POST","route":"/"}),
+        serde_json::json!({"type":"request-chunk","offset":0}),
+        serde_json::json!({"type":"request-end","bytes":0}),
+        serde_json::json!({"type":"forwarding-intent"}),
+        serde_json::json!({"type":"transport-link","exchange":"01".repeat(32)}),
+        serde_json::json!({"type":"http-metadata-chunk","direction":"request","offset":0,"total":0}),
+        serde_json::json!({"type":"http-metadata","direction":"response","headers":[],"omitted":[]}),
+        serde_json::json!({"type":"response-head","status":200}),
+        serde_json::json!({"type":"response-chunk","offset":0}),
+        serde_json::json!({"type":"terminal","outcome":"completed"}),
+    ] {
+        let mut header: serde_json::Value = serde_json::from_str(HEADER).unwrap();
+        header["event"] = event;
+        assert!(matches!(
+            decode(&wire(&header.to_string(), b"")).unwrap(),
+            Decoded::Capture(_)
+        ));
+        for extra in [
+            serde_json::json!(1),
+            serde_json::json!({"nested":[1,2,3]}),
+            serde_json::Value::Null,
+        ] {
+            let mut changed = header.clone();
+            changed["event"]["unrecognized"] = extra;
+            rejected(&wire(&changed.to_string(), b""), Error::Header);
+        }
+    }
+}
+
+#[test]
+fn recognized_header_requires_explicit_timestamp_even_when_unknown() {
+    let mut header: serde_json::Value = serde_json::from_str(HEADER).unwrap();
+    header["observed_at_unix_micros"] = serde_json::Value::Null;
+    assert!(matches!(
+        decode(&wire(&header.to_string(), b"")),
+        Ok(Decoded::Capture(_))
+    ));
+    header
+        .as_object_mut()
+        .unwrap()
+        .remove("observed_at_unix_micros");
+    rejected(&wire(&header.to_string(), b""), Error::Header);
+}
+
+#[test]
+fn capture_family_size_limit_precedes_unknown_envelope_classification() {
+    for version in [b'1', b'3', 0xff] {
+        let mut bytes = vec![0; MAX_FRAME];
+        bytes[..4].copy_from_slice(b"KANC");
+        bytes[4] = version;
+        assert!(matches!(
+            decode(&bytes),
+            Ok(Decoded::Unsupported(Unsupported::Envelope))
+        ));
+        bytes.push(0);
+        rejected(&bytes, Error::Limit);
+    }
+    // Opaque non-capture inputs are not parsed or copied by this decoder.
+    assert!(matches!(
+        decode(&vec![0; MAX_FRAME + 1]),
+        Ok(Decoded::Opaque)
+    ));
+}
