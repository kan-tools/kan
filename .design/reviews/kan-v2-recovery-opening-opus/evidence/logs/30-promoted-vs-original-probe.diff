> 
> fn reviewer_case(name: &str) -> Case {
>     let f: Value = serde_json::from_str(include_str!(
>         "../.design/fixtures/recovery-replay-review-v1.json"
>     ))
>     .unwrap();
>     Case::parse(
>         f["cases"]
>             .as_array()
>             .unwrap()
>             .iter()
>             .find(|v| v["name"] == name)
>             .unwrap()
>             .clone(),
>     )
> }
> #[test]
> fn writer_invalid_candidate_refuses_without_publication_intent() {
>     let c = reviewer_case("P01-writer-invalid-restoration-without-intent");
>     assert_eq!(
>         c.verify(limits()).err(),
>         Some(Error::Invalid("candidate writer request"))
>     );
> }
> #[test]
> fn valid_writer_signature_with_wrong_manifest_binding_refuses() {
>     let c = reviewer_case("P21-valid-writer-signature-wrong-manifest-binding");
>     assert_eq!(
>         c.verify(limits()).err(),
>         Some(Error::Invalid("candidate writer request"))
>     );
> }
> #[test]
> fn unavailable_partition_has_a_pinned_conservative_envelope_bound() {
>     let f: Value = serde_json::from_str(include_str!(
>         "../.design/fixtures/recovery-replay-review-v1.json"
>     ))
>     .unwrap();
>     let bound = f["envelopeArithmetic"]["conservative80ByteDidEnvelopeBound"]
>         .as_u64()
>         .unwrap();
>     assert_eq!(bound, 3816);
>     assert!(bound < kan::evidence_recovery_observation::MAX_ENVELOPE as u64);
> }
