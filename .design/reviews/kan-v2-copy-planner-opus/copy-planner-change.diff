+#!/usr/bin/env python3
+"""Compiled plan/source regressions. Run only while the shared build cache is idle."""
+from pathlib import Path
+import subprocess
+ROOT=Path(__file__).resolve().parents[1]
+PLAN=ROOT/'src/evidence_copy_plan.rs'
+SOURCE=ROOT/'src/evidence_store/copy_upgrade.rs'
+STORE=ROOT/'src/evidence_store.rs'
+OUT=ROOT/'.local-state/reviews/copy-plan-controls'
+def main():
+    if not __debug__:raise RuntimeError('assertions required')
+    OUT.mkdir(parents=True,exist_ok=True)
+    originals={p:p.read_text() for p in (PLAN,SOURCE,STORE)}
+    for p,s in originals.items():(OUT/(p.name+'.original')).write_text(s)
+    cases=[
+        ('skip-request-authentication',SOURCE,originals[SOURCE].replace('service::verify_retained_request(&record, &request_bytes)','serde_json::from_slice::<service::SignedRequest>(&request_bytes)'),'evidence_copy_source','structurally_healthy_raw_archives_cannot_bypass_request_authentication'),
+        ('allow-current-k256',PLAN,originals[PLAN].replace('if require_p256 && algorithm != atrium_crypto::Algorithm::P256 {','if false && require_p256 && algorithm != atrium_crypto::Algorithm::P256 {'),'evidence_copy_plan','malformed_or_unsupported_plans_refuse'),
+        ('omit-staged-object-inventory',SOURCE,originals[SOURCE][:originals[SOURCE].index('        // Bind staged-but-uncommitted objects')]+originals[SOURCE][originals[SOURCE].index('        let plan = Plan::new('):],'evidence_copy_source','staged_but_uncommitted_objects_are_part_of_the_source_commitment'),
+        ('ignore-owner-archive',PLAN,originals[PLAN].replace('if &self.archive != expected {','if false && &self.archive != expected {'),'evidence_copy_plan','changing_each_owner_pin_or_source_coordinate_changes_archive_identity'),
+        ('ignore-receipts-in-source-digest',SOURCE,originals[SOURCE].replace('frame(&mut hash, record.receipt.bytes());','let _ = record.receipt.bytes();'),'evidence_copy_source','same_frontier_with_a_changed_unsigned_receipt_fails_exact_plan_confirmation'),
+        ('confirm-frontier-only',SOURCE,originals[SOURCE].replace('if checked.plan.bytes() != plan.bytes() {','if checked.plan.source().through != plan.source().through || checked.plan.source().tip != plan.source().tip {'),'evidence_copy_source','same_frontier_with_a_changed_unsigned_receipt_fails_exact_plan_confirmation'),
+        ('ignore-historical-issuer',SOURCE,originals[SOURCE].replace('|| signed.request.audience != historical_issuer','|| false'),'evidence_copy_source','plans_require_explicit_scope_historical_issuer_and_all_source_payloads'),
+        ('ignore-target-scope',SOURCE,originals[SOURCE].replace('signed.request.scope != service::hex(&target.scope)','false'),'evidence_copy_source','plans_require_explicit_scope_historical_issuer_and_all_source_payloads'),
+        ('unpin-source-transaction',STORE,originals[STORE].replace('PRAGMA query_only=ON; BEGIN;','PRAGMA query_only=ON;'),'evidence_copy_source','source_plan_is_pinned_and_reconfirmation_detects_later_admission'),
+    ]
+    try:
+        for name,p,s,suite,test in cases:
+            assert s!=originals[p],name+' inactive';p.write_text(s)
+            run=subprocess.run(['cargo','test','--features','v2-crypto','--test',suite,test,'--','--exact'],cwd=ROOT,capture_output=True,text=True)
+            log=run.stdout+run.stderr;(OUT/(name+'.txt')).write_text(log)
+            assert run.returncode!=0,name+' SURVIVED';assert 'could not compile' not in log,name+' compile failure';assert 'test '+test+' ... FAILED' in log,name+' no named assertion'
+            print('DEMONSTRATED:',name,flush=True);p.write_text(originals[p])
+    finally:
+        for p,s in originals.items():p.write_text(s)
+    run=subprocess.run(['cargo','test','--features','v2-crypto','--test','evidence_copy_plan','--test','evidence_copy_source'],cwd=ROOT,capture_output=True,text=True)
+    (OUT/'restored.txt').write_text(run.stdout+run.stderr);assert run.returncode==0,'restored baseline failed'
+    print(f'{len(cases)} compiled mutants fail; restored plan/source tests pass.',flush=True)
+if __name__=='__main__':main()
diff --git a/src/evidence_copy_plan.rs b/src/evidence_copy_plan.rs
new file mode 100644
index 0000000..aa4fab5
--- /dev/null
+++ b/src/evidence_copy_plan.rs
@@ -0,0 +1,170 @@
+//! Owner-pinned recipe for a future profile-1 to profile-3 copy.
+//!
+//! Decoding establishes canonical structure and the archive-ID commitment only.
+//! It does not verify a source snapshot, authorize migration, certify historical
+//! admission, or create an archive. Execution must independently verify the exact
+//! pinned source and all retained signed requests before using this recipe.
+use crate::evidence::{self, Error};
+use atproto_dasl::{Cid, Ipld};
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+
+pub const MAX_PLAN_BYTES: usize = 4096;
+const DOMAIN: &[u8] = b"tools.kan.archive.copy-plan.v1\0";
+type Result<T> = std::result::Result<T, Error>;
+fn invalid(message: &str) -> Error {
+    Error::Schema(message.into())
+}
+fn map<const N: usize>(fields: [(&str, Ipld); N]) -> Ipld {
+    Ipld::Map(
+        fields
+            .into_iter()
+            .map(|(k, v)| (k.into(), v))
+            .collect::<BTreeMap<_, _>>(),
+    )
+}
+
+/// Coordinates and commitments supplied by a separately verified source planner.
+/// Constructing this value confers no authority over a legacy archive.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Source {
+    pub through: u64,
+    pub tip: Option<Cid>,
+    pub digest: [u8; 32],
+    pub historical_issuer: String,
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Target {
+    pub scope: [u8; 32],
+    pub issuer: String,
+}
+#[derive(Debug, Clone)]
+pub struct Plan {
+    bytes: Vec<u8>,
+    source: Source,
+    target: Target,
+    nonce: [u8; 32],
+    archive: [u8; 32],
+}
+fn did(value: &Ipld, require_p256: bool) -> Result<String> {
+    let did = evidence::string(value, 80)?;
+    // Bound before the dependency reads a multikey prefix.
+    if !(56..=80).contains(&did.len()) || !did.starts_with("did:key:z") || !did.is_ascii() {
+        return Err(invalid("copy-plan issuer encoding"));
+    }
+    let (algorithm, key) =
+        atrium_crypto::did::parse_did_key(did).map_err(|_| invalid("copy-plan issuer key"))?;
+    if require_p256 && algorithm != atrium_crypto::Algorithm::P256 {
+        return Err(invalid("copy-plan current issuer must use P-256"));
+    }
+    if atrium_crypto::did::format_did_key(algorithm, &key)
+        .map_err(|_| invalid("copy-plan issuer point"))?
+        != did
+    {
+        return Err(invalid("copy-plan issuer must be canonical"));
+    }
+    crate::evidence_service::author(did).map_err(|_| invalid("copy-plan static issuer"))?;
+    Ok(did.into())
+}
+fn bytes32(value: &Ipld) -> Result<[u8; 32]> {
+    Ok(evidence::bytes(value, 32)?
+        .try_into()
+        .expect("checked size"))
+}
+impl Plan {
+    /// Encode owner inputs; caller must independently establish their truth.
+    /// A fresh owner-generated nonce is required for each distinct destination.
+    pub fn new(source: Source, target: Target, nonce: [u8; 32]) -> Result<Self> {
+        let value = map([
+            ("recipe", Ipld::Integer(1)),
+            ("sourceProfile", Ipld::Integer(1)),
+            ("targetProfile", Ipld::Integer(3)),
+            ("sourceThrough", Ipld::Integer(i128::from(source.through))),
+            (
+                "sourceTip",
+                source.tip.map(Ipld::Link).unwrap_or(Ipld::Null),
+            ),
+            ("sourceDigest", Ipld::Bytes(source.digest.to_vec())),
+            ("historicalIssuer", Ipld::String(source.historical_issuer)),
+            ("scopeToken", Ipld::Bytes(target.scope.to_vec())),
+            ("issuer", Ipld::String(target.issuer)),
+            ("nonce", Ipld::Bytes(nonce.to_vec())),
+        ]);
+        let bytes = atproto_dasl::to_vec(&value).map_err(|_| invalid("copy-plan encoding"))?;
+        Self::decode(&bytes)
+    }
+    /// Verify a bounded canonical recipe. This is not a source-verification result.
+    pub fn decode(bytes: &[u8]) -> Result<Self> {
+        let value = evidence::canonical_value(bytes, MAX_PLAN_BYTES)?;
+        let b = evidence::closed(
+            &value,
+            &[
+                "recipe",
+                "sourceProfile",
+                "targetProfile",
+                "sourceThrough",
+                "sourceTip",
+                "sourceDigest",
+                "historicalIssuer",
+                "scopeToken",
+                "issuer",
+                "nonce",
+            ],
+        )?;
+        if b["recipe"] != Ipld::Integer(1)
+            || b["sourceProfile"] != Ipld::Integer(1)
+            || b["targetProfile"] != Ipld::Integer(3)
+        {
+            return Err(invalid("unsupported copy-plan profile or recipe"));
+        }
+        let through = evidence::uint(&b["sourceThrough"])? as u64;
+        let tip = match &b["sourceTip"] {
+            Ipld::Null if through == 0 => None,
+            link if through > 0 => Some(evidence::link(link, 0x71)?.clone()),
+            _ => return Err(invalid("copy-plan empty source frontier")),
+        };
+        let source = Source {
+            through,
+            tip,
+            digest: bytes32(&b["sourceDigest"])?,
+            historical_issuer: did(&b["historicalIssuer"], false)?,
+        };
+        let target = Target {
+            scope: bytes32(&b["scopeToken"])?,
+            issuer: did(&b["issuer"], true)?,
+        };
+        let nonce = bytes32(&b["nonce"])?;
+        let mut hash = Sha256::new();
+        hash.update(DOMAIN);
+        hash.update(bytes);
+        Ok(Self {
+            bytes: bytes.to_vec(),
+            source,
+            target,
+            nonce,
+            archive: hash.finalize().into(),
+        })
+    }
+    pub fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+    pub fn source(&self) -> &Source {
+        &self.source
+    }
+    pub fn target(&self) -> &Target {
+        &self.target
+    }
+    pub fn nonce(&self) -> &[u8; 32] {
+        &self.nonce
+    }
+    pub fn archive_id(&self) -> [u8; 32] {
+        self.archive
+    }
+    /// Compare to an owner pin; never choose the expected value from this plan.
+    pub fn check_archive(&self, expected: &[u8; 32]) -> Result<()> {
+        if &self.archive != expected {
+            return Err(invalid("copy-plan owner archive mismatch"));
+        }
+        Ok(())
+    }
+}
