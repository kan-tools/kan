+    let restored = PlannedCopy::confirm(&rebuilt, &plan, &plan.archive_id()).unwrap();
+    assert_eq!(restored.plan().bytes(), plan.bytes());
+    assert_eq!(std::fs::read(&db).unwrap(), damaged);
