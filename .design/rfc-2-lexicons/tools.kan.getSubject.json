{
  "lexicon": 1,
  "id": "tools.kan.getSubject",
  "defs": {
    "main": {
      "type": "query",
      "description": "Resolve a page of claims for one subject in one account repository and kan scope.",
      "parameters": {
        "type": "params",
        "required": ["repo", "scope", "subject"],
        "properties": {
          "repo": {"type": "string", "format": "did"},
          "scope": {"type": "string", "maxLength": 512},
          "subject": {"type": "string", "maxLength": 4096},
          "commit": {"type": "string", "format": "cid"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
          "cursor": {"type": "string", "maxLength": 2048}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["canonicalUri", "replayUri", "provenance", "claims"],
          "properties": {
            "canonicalUri": {"type": "string", "format": "uri"},
            "replayUri": {"type": "string", "format": "uri"},
            "provenance": {"type": "ref", "ref": "tools.kan.defs#provenance"},
            "claims": {"type": "array", "maxLength": 1000, "items": {"type": "ref", "ref": "tools.kan.defs#claimView"}},
            "cursor": {"type": "string", "maxLength": 2048}
          }
        }
      },
      "errors": [
        {"name": "RepoNotFound"},
        {"name": "ScopeNotFound"},
        {"name": "SubjectNotFound"},
        {"name": "SnapshotUnavailable"},
        {"name": "InvalidCursor"},
        {"name": "CursorSnapshotMismatch"},
        {"name": "InvalidClaim"},
        {"name": "UnsupportedClaimCodec"},
        {"name": "IndexNotReady"}
      ]
    }
  }
}
