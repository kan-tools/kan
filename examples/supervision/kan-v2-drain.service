# Example only. Copy and edit explicitly; no installer runs this unit.
[Unit]
Description=kan encrypted archive delivery
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kan
Group=kan
UMask=0077
ExecStart=/usr/local/bin/kan-v2 spool-watch /srv/kan/collector.spool --journal /srv/kan/collector.health --endpoint http://127.0.0.1:7282/v1/rpc
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kan
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
